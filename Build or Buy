      </div>
      <input type="range" min={min} max={max} step={step} value={value} onChange={e => onChange(Number(e.target.value))}
        style={{ width: "100%", accentColor: "#00A6A0", cursor: "pointer" }} />
      {note && <div style={{ fontSize: 10, color: "rgba(255,255,255,0.25)", marginTop: 3 }}>{note}</div>}
    </div>
  );
}

function BarChart({ data, height = 180 }) {
  const max = Math.max(...data.map(d => Math.abs(d.value)));
  return (
    <div style={{ display: "flex", alignItems: "flex-end", gap: 8, height, paddingBottom: 24, position: "relative" }}>
      {data.map((d, i) => {
        const h = (Math.abs(d.value) / max) * (height - 40);
        const isNeg = d.value < 0;
        return (
          <div key={i} style={{ flex: 1, display: "flex", flexDirection: "column", alignItems: "center", gap: 4 }}>
            <div style={{ fontSize: 10, color: isNeg ? "#FF6B6B" : "#00A6A0", fontWeight: 700, fontFamily: "var(--mono)", whiteSpace: "nowrap" }}>
              {fmtK(d.value)}
            </div>
            <div style={{ width: "100%", height: h, background: isNeg ? "rgba(255,107,107,0.6)" : `rgba(${d.color || "0,166,160"},0.7)`, borderRadius: "4px 4px 0 0", border: `1px solid ${isNeg ? "rgba(255,107,107,0.4)" : "rgba(0,166,160,0.4)"}`, transition: "height 0.4s cubic-bezier(0.4,0,0.2,1)" }} />
            <div style={{ fontSize: 10, color: "rgba(255,255,255,0.4)", textAlign: "center", lineHeight: 1.3, position: "absolute", bottom: 0 }}>{d.label}</div>
          </div>
        );
      })}
    </div>
  );
}


  rehabCost: 75000,
  acquireSalePrice: 320000,
  acquireTimeline: 8,
  acquiresPerYear: 15,
  govGrantPerAcquire: 80000,
  volunteerHoursPerAcquire: 2800,
  // BuyBack cycling
  buybackCycles: 3,
  buybackRefreshCost: 45000,
  yearsPerCycle: 8,
  // Shared
  annualGovGrant: 1104827,
  targetHomes: 45,
  targetYears: 3,
};

const fmt = (n, type = "dollar") => {
  if (type === "dollar") return n < 0
    ? `-$${Math.abs(n).toLocaleString()}`
    : `$${n.toLocaleString()}`;
  if (type === "pct") return `${(n * 100).toFixed(1)}%`;
  if (type === "num") return n.toLocaleString();
  if (type === "mo") return `${n} mo.`;
  return n;
};

const fmtK = (n) => {
  if (Math.abs(n) >= 1000000) return `$${(n/1000000).toFixed(1)}M`;
  if (Math.abs(n) >= 1000) return `$${(n/1000).toFixed(0)}K`;
  return `$${n}`;
};

// ── Calculations ──────────────────────────────────────────────────────────────
function calc(p) {
  const buildNetPerHome = p.buildSalePrice - p.buildCost + p.govGrantPerBuild;
  const buildTotalCapital = p.buildCost * p.targetHomes;
  const buildTotalDeficit = buildNetPerHome * p.targetHomes;
  const buildAnnualDeficit = buildTotalDeficit / p.targetYears;

  const acqTotalCostPerHome = p.acquireCost + p.rehabCost;
  const acqNetPerHome = p.acquireSalePrice - acqTotalCostPerHome + p.govGrantPerAcquire;
  const acqTotalCapital = acqTotalCostPerHome * p.targetHomes;
  const acqTotalDeficit = acqNetPerHome * p.targetHomes;
  const acqAnnualDeficit = acqTotalDeficit / p.targetYears;

  // BuyBack value: one home serves multiple families
  const buybackTotalFamilies = p.buybackCycles;
  const buybackTotalCost = p.acquireCost + p.rehabCost + (p.buybackCycles - 1) * p.buybackRefreshCost;
  const buybackCostPerFamily = buybackTotalCost / p.buybackCycles;
  const buybackVsBuildSaving = p.buildCost - buybackCostPerFamily;

  // Capital efficiency: homes per $1M
  const buildHomesPerMillion = 1000000 / p.buildCost;
  const acqHomesPerMillion = 1000000 / acqTotalCostPerHome;

  // 3-year program totals
  const buildFamiliesServed = p.targetHomes;
  const acqFamiliesServed = p.targetHomes;

  // Volunteer hours
  const buildTotalHours = p.volunteerHoursPerBuild * p.targetHomes;
  const acqTotalHours = p.volunteerHoursPerAcquire * p.targetHomes;

  return {
    buildNetPerHome, buildTotalCapital, buildTotalDeficit, buildAnnualDeficit,
    acqTotalCostPerHome, acqNetPerHome, acqTotalCapital, acqTotalDeficit, acqAnnualDeficit,
    buybackTotalFamilies, buybackTotalCost, buybackCostPerFamily, buybackVsBuildSaving,
    buildHomesPerMillion, acqHomesPerMillion,
    buildFamiliesServed, acqFamiliesServed,
    buildTotalHours, acqTotalHours,
    capitalSaving: buildTotalCapital - acqTotalCapital,
    deficitSaving: buildTotalDeficit - acqTotalDeficit,
  };
}


                    ].map(([k, v, c]) => (
                      <div key={k} style={{ background: "rgba(255,255,255,0.03)", borderRadius: 8, padding: "14px 16px" }}>
                        <div style={{ fontSize: 10, color: "rgba(255,255,255,0.3)", fontFamily: "var(--mono)", marginBottom: 6 }}>{k}</div>
                        <div style={{ fontSize: 22, fontWeight: 800, color: c, fontFamily: "var(--display)" }}>{v}</div>
                      </div>
                    ))}
                  </div>
                );
              })()}
            </div>
          </div>
        )}

        {/* ── TAB: BUYBACK ── */}
        {tab === "buyback" && (
          <div className="fade-in">
            <div style={{ marginBottom: 20 }}>
              <h2 style={{ fontFamily: "var(--display)", fontSize: 24, color: "#fff", marginBottom: 8 }}>The BuyBack Multiplier Effect</h2>
              <p style={{ fontSize: 13, color: "rgba(255,255,255,0.5)", lineHeight: 1.7, maxWidth: 680 }}>
                The BuyBack program turns a single home into a perpetual community asset. Each home acquired and enrolled in BuyBack can serve multiple families over its lifespan — dramatically reducing the effective cost per family served over time.
              </p>
            </div>

            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 20, marginBottom: 24 }}>
              <div style={{ background: "rgba(0,166,160,0.04)", border: "1px solid rgba(0,166,160,0.15)", borderRadius: 12, padding: 24 }}>
                <div style={{ fontSize: 10, letterSpacing: 3, color: TEAL, fontFamily: "var(--mono)", marginBottom: 16 }}>BUYBACK LIFECYCLE — ONE HOME</div>
                {[...Array(p.buybackCycles)].map((_, i) => {
                  const cost = i === 0 ? (p.acquireCost + p.rehabCost) : p.buybackRefreshCost;
                  const cumCost = i === 0 ? cost : (p.acquireCost + p.rehabCost) + i * p.buybackRefreshCost;
                  const costPerFam = cumCost / (i + 1);
                  return (
                    <div key={i} style={{ display: "flex", gap: 14, marginBottom: 16, alignItems: "flex-start" }}>
                      <div style={{ width: 28, height: 28, background: TEAL, borderRadius: "50%", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 12, fontWeight: 700, flexShrink: 0 }}>{i + 1}</div>
                      <div style={{ flex: 1 }}>
                        <div style={{ fontSize: 13, color: "#fff", fontWeight: 600, marginBottom: 2 }}>
                          {i === 0 ? "Initial acquisition + rehab" : `BuyBack cycle ${i} — refresh`}
                        </div>
                        <div style={{ display: "flex", gap: 16, fontSize: 11, color: "rgba(255,255,255,0.4)", fontFamily: "var(--mono)" }}>
                          <span>Cycle cost: {fmtK(cost)}</span>
                          <span>Cumulative cost/family: <span style={{ color: TEAL }}>{fmtK(Math.round(costPerFam))}</span></span>
                        </div>
                      </div>
                    </div>
                  );
                })}

                <div style={{ marginTop: 16, padding: 16, background: "rgba(0,166,160,0.1)", borderRadius: 8 }}>
                  <div style={{ fontSize: 10, letterSpacing: 2, color: TEAL, fontFamily: "var(--mono)", marginBottom: 6 }}>AFTER {p.buybackCycles} CYCLES</div>
                  <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 }}>
                    <div>
                      <div style={{ fontSize: 10, color: "rgba(255,255,255,0.3)" }}>Families served</div>
                      <div style={{ fontSize: 24, fontWeight: 800, color: TEAL, fontFamily: "var(--display)" }}>{p.buybackCycles}</div>
                    </div>
                    <div>
                      <div style={{ fontSize: 10, color: "rgba(255,255,255,0.3)" }}>Cost per family</div>
                      <div style={{ fontSize: 24, fontWeight: 800, color: TEAL, fontFamily: "var(--display)" }}>{fmtK(Math.round(r.buybackCostPerFamily))}</div>
                    </div>
                    <div>
                      <div style={{ fontSize: 10, color: "rgba(255,255,255,0.3)" }}>vs. new build cost</div>
                      <div style={{ fontSize: 24, fontWeight: 800, color: TEAL, fontFamily: "var(--display)" }}>{fmtK(p.buildCost)}</div>
                    </div>
                    <div>
                      <div style={{ fontSize: 10, color: "rgba(255,255,255,0.3)" }}>Saving vs. build</div>
                      <div style={{ fontSize: 24, fontWeight: 800, color: TEAL, fontFamily: "var(--display)" }}>{fmtK(Math.round(r.buybackVsBuildSaving))}</div>
                    </div>
                  </div>
                </div>
              </div>

              <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
                <div style={{ background: "rgba(255,255,255,0.03)", border: "1px solid rgba(255,255,255,0.06)", borderRadius: 12, padding: 24 }}>
                  <div style={{ fontSize: 10, letterSpacing: 3, color: "rgba(255,255,255,0.3)", fontFamily: "var(--mono)", marginBottom: 12 }}>SCALING BUYBACK — 45 HOMES ENROLLED</div>
                  <p style={{ fontSize: 13, color: "rgba(255,255,255,0.5)", lineHeight: 1.7, marginBottom: 16 }}>
                    If all 45 target homes are acquired and enrolled in BuyBack, the long-term program impact compounds significantly beyond the initial 3-year window.
                  </p>
                  {(() => {
                    const totalFamilies = 45 * p.buybackCycles;
                    const totalCost = 45 * r.buybackTotalCost;
                    const cpf = totalCost / totalFamilies;
                    const vsBuild = 45 * p.buildCost - totalCost;
                    return (
                      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
                        {[
                          ["Total families served", totalFamilies, TEAL],
                          ["Total program cost", fmtK(Math.round(totalCost)), "rgba(255,255,255,0.7)"],
                          ["Cost per family", fmtK(Math.round(cpf)), TEAL],
                          ["Capital saved vs. all-build", fmtK(Math.round(vsBuild)), TEAL],
                        ].map(([k, v, c]) => (
                          <div key={k} style={{ background: "rgba(0,166,160,0.06)", borderRadius: 8, padding: "12px 14px" }}>
                            <div style={{ fontSize: 10, color: "rgba(255,255,255,0.3)", fontFamily: "var(--mono)", marginBottom: 4 }}>{k}</div>
                            <div style={{ fontSize: 20, fontWeight: 800, color: c, fontFamily: "var(--display)" }}>{v}</div>
                          </div>
                        ))}
                      </div>
                    );
                  })()}
                </div>

                <div style={{ background: "rgba(255,255,255,0.02)", border: "1px solid rgba(255,255,255,0.06)", borderRadius: 12, padding: 20 }}>
                  <div style={{ fontSize: 10, letterSpacing: 3, color: "rgba(255,255,255,0.3)", fontFamily: "var(--mono)", marginBottom: 10 }}>ACQUISITION PIPELINE — WHERE TO SOURCE HOMES</div>
                  {[
                    ["City of Edmonton surplus properties", "Below-market transfer for affordable housing mandate"],
                    ["Alberta Housing provincial stock", "Aging social housing candidates for transfer"],
                    ["Civida portfolio optimization", "ECF-connected partner — $20M already in play"],
                    ["Open market — estate/distressed", "Older Edmonton neighbourhoods, value-add candidates"],
                    ["Federal surplus land (CMHC)", "Public Lands for Homes plan — federal priority"],
                  ].map(([source, note]) => (
                    <div key={source} style={{ display: "flex", gap: 10, marginBottom: 10, alignItems: "flex-start" }}>
                      <span style={{ color: TEAL, fontSize: 12, flexShrink: 0, marginTop: 1 }}>→</span>
                      <div>
                        <div style={{ fontSize: 12, color: "rgba(255,255,255,0.7)", fontWeight: 500 }}>{source}</div>
                        <div style={{ fontSize: 11, color: "rgba(255,255,255,0.3)" }}>{note}</div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )}

        {/* ── TAB: ASSUMPTIONS ── */}
        {tab === "assumptions" && (
          <div className="fade-in">
            <p style={{ fontSize: 13, color: "rgba(255,255,255,0.4)", marginBottom: 24, lineHeight: 1.7 }}>
              All assumptions are editable. Changes update the comparison, 3-year model, and BuyBack analysis in real time. Blue values in the comparison tabs reflect your inputs.
            </p>
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 24 }}>
              <div>
                <div style={{ fontSize: 10, letterSpacing: 3, color: ORANGE, fontFamily: "var(--mono)", marginBottom: 16 }}>🏗 BUILD MODEL</div>
                <Slider label="Build cost per home" value={p.buildCost} min={800000} max={2500000} step={25000} onChange={set("buildCost")} note="2025 implied: ~$1.52M" />
                <Slider label="Sale price to family" value={p.buildSalePrice} min={600000} max={1800000} step={25000} onChange={set("buildSalePrice")} note="2025 implied: ~$1.28M" />
                <Slider label="Gov. grant per build" value={p.govGrantPerBuild} min={0} max={500000} step={5000} onChange={set("govGrantPerBuild")} note="2025: $1.1M / 7 homes" />
                <Slider label="Delivery timeline" value={p.buildTimeline} min={6} max={30} step={1} onChange={set("buildTimeline")} format="mo" note="Months from approval to occupancy" />
                <Slider label="Volunteer hrs / home" value={p.volunteerHoursPerBuild} min={1000} max={15000} step={100} onChange={set("volunteerHoursPerBuild")} format="num" note="2025: 44,914 hrs / 7 homes" />
              </div>
              <div>
                <div style={{ fontSize: 10, letterSpacing: 3, color: TEAL, fontFamily: "var(--mono)", marginBottom: 16 }}>🏠 ACQUIRE + REFRESH</div>
                <Slider label="Acquisition cost" value={p.acquireCost} min={200000} max={700000} step={10000} onChange={set("acquireCost")} note="Edmonton older neighbourhood estimate" />
                <Slider label="Refresh / rehab cost" value={p.rehabCost} min={20000} max={200000} step={5000} onChange={set("rehabCost")} note="Volunteer labour + materials" />
                <Slider label="Sale price to family" value={p.acquireSalePrice} min={200000} max={600000} step={10000} onChange={set("acquireSalePrice")} note="Affordable pricing for qualifying family" />
                <Slider label="Gov. grant per acquire" value={p.govGrantPerAcquire} min={0} max={300000} step={5000} onChange={set("govGrantPerAcquire")} note="CMHC rehab / existing unit funding" />
                <Slider label="Delivery timeline" value={p.acquireTimeline} min={2} max={18} step={1} onChange={set("acquireTimeline")} format="mo" note="Acquisition to occupancy" />
                <Slider label="Volunteer hrs / home" value={p.volunteerHoursPerAcquire} min={200} max={6000} step={100} onChange={set("volunteerHoursPerAcquire")} format="num" note="Refresh weekend + light reno" />
              </div>
              <div>
                <div style={{ fontSize: 10, letterSpacing: 3, color: "rgba(255,255,255,0.3)", fontFamily: "var(--mono)", marginBottom: 16 }}>📊 PROGRAM & BUYBACK</div>
                <Slider label="Target homes (3-yr goal)" value={p.targetHomes} min={10} max={80} step={5} onChange={set("targetHomes")} format="num" note="CEO stated goal: 45 homes" />
                <Slider label="Target years" value={p.targetYears} min={1} max={5} step={1} onChange={set("targetYears")} format="num" />
                <Slider label="BuyBack cycles per home" value={p.buybackCycles} min={1} max={6} step={1} onChange={set("buybackCycles")} format="num" note="Families served per property over lifespan" />
                <Slider label="BuyBack refresh cost" value={p.buybackRefreshCost} min={10000} max={120000} step={5000} onChange={set("buybackRefreshCost")} note="Per refresh cycle (subsequent families)" />
              </div>
            </div>

            <div style={{ marginTop: 24, background: "rgba(255,255,255,0.02)", border: "1px solid rgba(255,255,255,0.06)", borderRadius: 12, padding: 20 }}>
              <div style={{ fontSize: 10, letterSpacing: 3, color: "rgba(255,255,255,0.3)", fontFamily: "var(--mono)", marginBottom: 10 }}>DATA SOURCES</div>
              <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 8 }}>
                {[
                  ["Build cost & sale price", "Habitat Edmonton 2025 audited financials (KPMG)"],
                  ["Government grants", "Habitat Edmonton 2025 income statement"],
                  ["Volunteer hours", "2025 Annual Report — 44,914 hrs / 7 homes"],
                  ["Acquisition cost", "Edmonton MLS market data estimate — older stock"],
                  ["Rehab cost", "Industry benchmark — light residential renovation"],
                  ["Gov. grant (acquire)", "CMHC National Housing Co-Investment Fund — rehab stream"],
                  ["BuyBack mechanics", "Habitat Canada program documentation"],
                  ["Pipeline sources", "ECF-Civida announcement, federal Public Lands plan"],
                ].map(([k, v]) => (
                  <div key={k} style={{ display: "flex", gap: 8 }}>
                    <span style={{ color: TEAL, fontSize: 11, flexShrink: 0 }}>·</span>
                    <div>
                      <span style={{ fontSize: 11, color: "rgba(255,255,255,0.6)", fontWeight: 500 }}>{k}: </span>
                      <span style={{ fontSize: 11, color: "rgba(255,255,255,0.35)" }}>{v}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        <div style={{ height: 48 }} />
      </div>
    </div>
  );
}
